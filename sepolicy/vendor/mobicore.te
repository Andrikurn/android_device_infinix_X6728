type mobicore, domain;
type mobicore_exec, exec_type, file_type, vendor_file_type;
type mobicore_vendor_file, file_type, vendor_file_type;
type mobicore_data_file, file_type, data_file_type;
type mobicore_user_device, dev_type;
type mobicore_admin_device, dev_type;
type mobicore_tui_device, dev_type;

init_daemon_domain(mobicore)

allow mobicore mobicore_vendor_file:file r_file_perms;
allow mobicore mobicore_data_file:dir create_dir_perms;
allow mobicore mobicore_data_file:file create_file_perms;
allow mobicore mobicore_admin_device:chr_file rw_file_perms;
allow mobicore mobicore_user_device:chr_file rw_file_perms;
allow mobicore mobicore_tui_device:chr_file r_file_perms;
allow mobicore mnt_vendor_file:dir search;
allow mobicore persist_data_file:dir create_dir_perms;
allow mobicore persist_data_file:file create_file_perms;
set_prop(mobicore, vendor_trustonic_prop)

allow hal_keymint_default mobicore:unix_stream_socket { read write connectto };
allow hal_keymint_default mobicore_user_device:chr_file rw_file_perms;
allow hal_gatekeeper_default mobicore:unix_stream_socket { read write connectto };
allow hal_gatekeeper_default mobicore_user_device:chr_file rw_file_perms;
allow hal_gatekeeper_default mobicore_data_file:dir create_dir_perms;
allow hal_gatekeeper_default mobicore_data_file:file create_file_perms;
allow hal_tee_default mobicore_user_device:chr_file rw_file_perms;
allow hal_tee_default mobicore_tui_device:chr_file rw_file_perms;
