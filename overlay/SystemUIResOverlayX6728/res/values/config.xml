<resources>
    <!-- Margin on the right side of the system icon group on Keyguard. -->
    <dimen name="system_icons_keyguard_padding_end">0dp</dimen>

    <!-- Starting padding for a left-aligned status bar clock -->
    <dimen name="status_bar_left_clock_starting_padding">0.0px</dimen>

    <!-- Margin on the left side of the carrier text on Keyguard -->
    <dimen name="keyguard_carrier_text_margin">4dp</dimen>

    <!-- The padding on the side of the navigation bar. Must be greater than or equal to
         navigation_extra_key_width -->
    <dimen name="navigation_side_padding">40dp</dimen>
    <dimen name="rounded_corner_content_padding">0dp</dimen>
    <dimen name="status_bar_padding_end">3dp</dimen>
    <dimen name="status_bar_padding_start">3dp</dimen>

    <!-- Determines whether the shell features all run on another thread. -->
    <bool name="config_enableShellMainThread">true</bool>

    <!-- Blur radius behind Notification Shade -->
    <dimen name="max_shade_window_blur_radius">23dp</dimen>
</resources>
