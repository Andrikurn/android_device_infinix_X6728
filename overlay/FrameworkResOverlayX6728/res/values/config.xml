    <!-- Stability requirements in milliseconds for accepting a new brightness level. -->
    <integer name="config_autoBrightnessBrighteningLightDebounce">2000</integer>
    <integer name="config_autoBrightnessDarkeningLightDebounce">3000</integer>

    <!-- Screen brightness used to dim the screen while dozing in a very low power state. -->
    <integer name="config_screenBrightnessDoze">5</integer>

    <!-- The type of the light sensor to be used by the display framework for things like
         auto-brightness. -->
    <string name="config_displayLightSensorType" translatable="false">android.sensor.light</string>

    <!-- The default peak refresh rate for a given device. -->
    <integer name="config_defaultPeakRefreshRate">120</integer>

    <!-- The default refresh rate for a given device. -->
    <integer name="config_defaultRefreshRate">0</integer>

    <!-- The bounding path of the cutout region of the main built-in display. -->
    <string name="config_mainBuiltInDisplayCutout" translatable="false">M -24,0 L -24,40 L 24,40 L 24,0 Z @dp</string>

    <!-- Bounding rect approximation of the cutout region of the main built-in display. -->
    <string name="config_mainBuiltInDisplayCutoutRectApproximation" translatable="false">M -24,0 L -24,40 L 24,40 L 24,0 Z @dp</string>

    <!-- Whether the display cutout region of the main built-in display should be forced to black. -->
    <bool name="config_fillMainBuiltInDisplayCutout">false</bool>

    <!-- Whether a software navigation bar should be shown. -->
    <bool name="config_showNavigationBar">true</bool>

    <!-- Disable display color fade animation -->
    <bool name="config_displayColorFadeDisabled">true</bool>

    <!-- Indicate whether the device supports accelerated color transforms -->
    <bool name="config_setColorTransformAccelerated">true</bool>

    <!-- Flag indicating whether surface flinger has limited alpha compositing functionality. -->
    <bool name="config_sf_limitedAlpha">true</bool>

    <!-- The amount to scale fullscreen snapshots for Overview and snapshot starting windows. -->
    <item name="config_highResTaskSnapshotScale" format="float" type="dimen">0.7</item>

    <!-- Power Management: Decouple auto-suspend and interactive state from display. -->
    <bool name="config_powerDecoupleAutoSuspendModeFromDisplay">true</bool>
    <bool name="config_powerDecoupleInteractiveModeFromDisplay">true</bool>

    <!-- Indicate whether to allow the device to suspend when the screen is off
         due to the proximity sensor. -->
    <bool name="config_suspendWhenScreenOffDueToProximity">true</bool>

    <!-- If this is true, the screen will come on when you unplug usb/power/whatever. -->
    <bool name="config_unplugTurnsOnScreen">true</bool>

    <!-- Whether this device is supporting the camera toggle -->
    <bool name="config_supportsCamToggle">true</bool>

    <!-- Whether this device is supporting the software microphone toggle -->
    <bool name="config_supportsMicToggle">true</bool>

    <!-- When true use the linux /dev/input/event subsystem to detect the switch changes
         on the headphone/microphone jack. -->
    <bool name="config_useDevInputEventForAudioJack">true</bool>

    <!-- Whether WiFi display is supported by this device. -->
    <bool name="config_enableWifiDisplay">true</bool>

    <!-- Number of physical SIM slots on the device. -->
    <integer name="config_num_physical_slots">2</integer>

    <!-- Is the device capable of hot swapping an UICC Card -->
    <bool name="config_hotswapCapable">true</bool>

    <!-- Boolean indicating USSD over IMS is allowed. -->
    <bool name="config_allow_ussd_over_ims">true</bool>

    <!-- Flag specifying whether VoLTE / WFC / VT / TTY are available. -->
    <bool name="config_carrier_volte_available">true</bool>
    <bool name="config_carrier_wfc_ims_available">true</bool>
    <bool name="config_carrier_volte_tty_supported">true</bool>
    <bool name="config_device_volte_available">true</bool>
    <bool name="config_device_vt_available">true</bool>
    <bool name="config_device_wfc_ims_available">true</bool>

    <!-- Config determines whether to update phone object when voice registration state changes. -->
    <bool name="config_switch_phone_on_voice_reg_state_change">false</bool>

    <!-- Boolean indicating if restoring network selection should be skipped. -->
    <bool name="skip_restoring_network_selection">true</bool>

